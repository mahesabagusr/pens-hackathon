# Used by `npm run dev` on the host. Docker Compose builds its own URLs from the same defaults.
DATABASE_URL="postgresql://app:app@127.0.0.1:5433/app"
NEO4J_URI="bolt://127.0.0.1:7688"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password123"

# Chat on the landing page. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional, defaults to gemini-flash-latest
# GEMINI_MODEL="gemini-flash-latest"

# Signs the login cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
