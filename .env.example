# Used by `npm run dev` on the host. Docker Compose builds its own URLs from the same defaults.
DATABASE_URL="postgresql://app:app@127.0.0.1:5433/app"
NEO4J_URI="bolt://127.0.0.1:7688"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password123"

# Chat in the dashboard. Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""
# Optional: deepseek-flash (default, cheaper) or deepseek-v4-pro
# DEEPSEEK_MODEL="deepseek-flash"

# Signs the login cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Jev (TypeSafe) reads interaction text for discovery. Only `npx tsx scripts/judge-interactions.mts` uses it;
# without it the app uses keyword rules. Get a key at https://typesafe.ai
TYPESAFE_API_KEY=""
# Lecturer's cap: at most 100M Jev input tokens per team. Every request is logged to jev-usage.jsonl (commit it).
# Optional: set a lower cap for yourself, or another ledger path.
# JEV_TOKEN_LIMIT="100000000"
# JEV_USAGE_FILE="jev-usage.jsonl"
# Optional: "1" makes Jev check every chat answer against the query results (FR-11).
# Each chat question then spends ~1k-16k Jev input tokens from the team cap above.
# JEV_CHAT_CHECK="1"
